{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@platform/*": ["src/platform/*"], "@app/*": ["src/app/*"] },
    "types": ["node", "wicg-file-system-access", "vite/client"]
  },
  "include": ["src", "tests", "../api", "vite.config.ts"]
}
